generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  DEVELOPER
  OWNER
  STAFF
}

enum MedCategory {
  MEDICINE
  VACCINE
}

enum NotificationType {
  LOW_EGG_STOCK
  LOW_FEED_STOCK
  VACCINATION_DUE
  GENERAL
}

enum FinType {
  INCOME
  EXPENSE
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  role        Role     @default(STAFF)
  isActive    Boolean  @default(true)
  companyName String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notifications  Notification[]
  financialNotes FinancialNote[]

  @@map("users")
}

model EggProduction {
  id             String   @id @default(cuid())
  date           DateTime @db.Date
  house          String
  populasi       Int?
  goodEggs       Int      @default(0)
  crackedEggs    Int      @default(0)
  rejectedEggs   Int      @default(0)
  goodEggsKg     Decimal? @db.Decimal(10, 2)
  crackedEggsKg  Decimal? @db.Decimal(10, 2)
  rejectedEggsKg Decimal? @db.Decimal(10, 2)
  feedQtyKg      Decimal? @db.Decimal(10, 2)
  feedPricePerKg Decimal? @db.Decimal(12, 2)
  feedProductId  String?
  mortality      Int?
  umurAyam       Int?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  feedProduct FeedProduct? @relation(fields: [feedProductId], references: [id], onDelete: SetNull)
  feedUsage   FeedUsage?

  @@index([date])
  @@index([feedProductId])
  @@map("egg_production")
}

model EggSale {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  customerName String
  invoiceNo    String?
  jatuhTempoDays Int?
  eggType      String?
  qtySold      Decimal  @db.Decimal(10, 2)
  unitPrice    Decimal  @db.Decimal(12, 2)
  totalValue   Decimal  @db.Decimal(14, 2)
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
  @@map("egg_sales")
}

model FinancialNote {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  type        FinType
  amount      Decimal  @db.Decimal(14, 2)
  description String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([userId])
  @@map("financial_notes")
}

model FeedProduct {
  id        String   @id @default(cuid())
  name      String
  unit      String   @default("kg")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases  FeedPurchase[]
  usages     FeedUsage[]
  sales      FeedSale[]
  productions EggProduction[]

  @@map("feed_products")
}

model FeedPurchase {
  id            String      @id @default(cuid())
  date          DateTime    @db.Date
  feedProductId String
  qty           Decimal     @db.Decimal(10, 2)
  pricePerKg    Decimal?    @db.Decimal(12, 2)
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  feedProduct FeedProduct @relation(fields: [feedProductId], references: [id], onDelete: Restrict)

  @@index([date])
  @@index([feedProductId])
  @@map("feed_purchases")
}

model FeedUsage {
  id            String      @id @default(cuid())
  date          DateTime    @db.Date
  house         String
  feedProductId String
  qtyUsed       Decimal     @db.Decimal(10, 2)
  unitCost      Decimal?    @db.Decimal(12, 2)
  totalCost     Decimal?    @db.Decimal(14, 2)
  notes         String?     @db.Text
  productionId  String?     @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  feedProduct FeedProduct    @relation(fields: [feedProductId], references: [id], onDelete: Restrict)
  production  EggProduction? @relation(fields: [productionId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([feedProductId])
  @@map("feed_usage")
}

model FeedSale {
  id            String      @id @default(cuid())
  date          DateTime    @db.Date
  customerName  String
  feedProductId String
  qty           Decimal     @db.Decimal(10, 2)
  unitPrice     Decimal     @db.Decimal(12, 2)
  totalValue    Decimal     @db.Decimal(14, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  feedProduct FeedProduct @relation(fields: [feedProductId], references: [id], onDelete: Restrict)

  @@index([date])
  @@index([feedProductId])
  @@map("feed_sales")
}

model MedicineVaccine {
  id          String      @id @default(cuid())
  date        DateTime    @db.Date
  productName String
  category    MedCategory
  qty         Decimal     @db.Decimal(10, 2)
  unit        String      @default("botol")
  notes       String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([date])
  @@index([category])
  @@map("medicine_vaccines")
}

model VaccinationSchedule {
  id           String   @id @default(cuid())
  vaccineName  String
  scheduleDate DateTime @db.Date
  notes        String?  @db.Text
  isDone       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([scheduleDate])
  @@map("vaccination_schedules")
}

model Mortality {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  house     String
  count     Int
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("mortality")
}

model House {
  id                String   @id @default(cuid())
  name              String   @unique
  currentPopulation Int      @default(0)
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("houses")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}
