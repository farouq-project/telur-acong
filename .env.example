# Database (Laragon MySQL)
DATABASE_URL="mysql://root:@localhost:3306/telur_acong"

# NextAuth
NEXTAUTH_SECRET="ganti-dengan-random-string-yang-panjang-dan-aman"
NEXTAUTH_URL="http://localhost:3000"

# Production (Vercel)
# DATABASE_URL="mysql://user:password@host:3306/telur_acong"
# NEXTAUTH_URL="https://yourdomain.vercel.app"
#
# Note: in production, src/lib/prisma.ts automatically appends
# "connection_limit=3&pool_timeout=10" to DATABASE_URL (if not already
# present) to avoid exhausting Hostinger's MySQL connection limit across
# concurrent Vercel serverless instances. Override by including
# connection_limit yourself, or set PRISMA_ACCELERATE_URL to use Prisma
# Accelerate's pooling instead.
